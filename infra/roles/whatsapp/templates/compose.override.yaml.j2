# Managed by dotfiles/infra (roles/whatsapp). The repo waha/compose.yaml pins the
# arm64-only tag; this Intel server runs the amd64 build of the same WAHA release.
# Start WAHA with both files:
#   docker compose -f {{ whatsapp_deploy }}/waha/compose.yaml -f {{ ansible_env.HOME }}/.config/waha/compose.override.yaml up -d
services:
  waha:
    image: {{ waha_image }}
