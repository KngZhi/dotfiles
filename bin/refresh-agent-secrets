#!/bin/zsh
# 把 ~/.config/agent-secrets/agent-secrets.env.tpl 里的 op:// 引用渲染成真实值。
# 需要 1Password CLI 且桌面 App 已开启「与 1Password CLI 集成」（会弹 Touch ID）。
set -euo pipefail
D="$HOME/.config/agent-secrets"
TPL="$D/agent-secrets.env.tpl"
OUT="$D/agent-secrets.env"
command -v op >/dev/null || { echo "op CLI not found: brew install --cask 1password-cli" >&2; exit 1; }
umask 077
op inject -f -i "$TPL" -o "$OUT"
chmod 600 "$OUT"
# 只报告变量名，绝不打印值
echo "rendered $OUT:"; grep -o -E '^export [A-Z_]+' "$OUT" | sed 's/export /  /'
echo "open a new shell (or: source $OUT) to pick it up"
