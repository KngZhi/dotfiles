# Copy to ~/.local/share/linear-local-agents/bridge/.env (mode 600).
# LINEAR_BRIDGE_API_KEY: the workspace owner's personal Linear API key —
#   the bridge must act as a human, because Linear only opens agent sessions
#   for human actions (op://DEV/Linear Cli SAOKO/credential).
# LINEAR_BRIDGE_WEBHOOK_SECRET: the signing secret of the workspace webhook
#   that points at <funnel host>/bridge (README: "Bridge").
BRIDGE_PORT=3458
LINEAR_BRIDGE_API_KEY=
LINEAR_BRIDGE_WEBHOOK_SECRET=
