# Per-instance environment for one Cyrus agent. Copy to
# ~/.local/share/linear-local-agents/<codex|claude>/.env (mode 600) and fill
# the three LINEAR_* values from the OAuth app in Linear Settings > API.
# Ports: codex 3456, claude 3457. The base URL is the public path Tailscale
# Funnel forwards to that port (see README.md).
CYRUS_HOME=/Users/amd/.local/share/linear-local-agents/codex
CYRUS_SERVER_PORT=3456
CYRUS_BASE_URL=https://<machine>.<tailnet>.ts.net/codex
CYRUS_DEFAULT_RUNNER=codex
CYRUS_SENTRY_DISABLED=true
LINEAR_DIRECT_WEBHOOKS=true
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
